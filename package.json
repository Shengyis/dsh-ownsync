{
  "name": "dsh-ownsync",
  "version": "1.0.0",
  "description": "在自己的 Git 服务器上同步 DSH 的工作区、会话与聊天附件，主力放在上传和下载两个按钮。",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sync",
    "backup",
    "self-hosted",
    "git"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "slots"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check"
  },
  "license": "MIT"
}
